# Заглушки общих переменных окружения. Заполняется копия, которую init кладёт
# в <каталог конфигов>/env с правами 600 — она в репозиторий не попадает.
#
# Значения доступны в рецептах как переменные шелла ($API_TOKEN), а не как
# {{ }}-подстановки just: {{ }} печатается в трассировке и в `just --dry-run`,
# $VAR — нет.

# базовый адрес API для рецепта `api`
API_BASE=https://api.example.com

# токен доступа к API; выпустить в личном кабинете сервиса
API_TOKEN=your-api-token-here
