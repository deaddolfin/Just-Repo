# ---------------------------------------------------------------------------
# group.just — пустая группа «none».
#
# Для машин, которым нужны только общие команды из global.just: init требует
# файл группы, и вместо выдумывания фиктивных рецептов сюда подключается этот
# файл-заглушка.
#
# Своих переменных у группы нет, поэтому рядом нет и env.example — init просто
# пропустит его при сборке env.
#
# Появились команды, нужные именно этой машине, — им место в local.just.
# Нужны команды для нескольких машин — заведите свою группу:
#     cp -r Config/example Config/<имя>
# ---------------------------------------------------------------------------

# Перезапустить Google worker
g_restart:
    sudo systemctl restart parserservice@Config_google

# Перезапустить Scraper worker
s_restart:
    sudo systemctl restart parserservice@Config_scrape
